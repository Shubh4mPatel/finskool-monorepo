generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  member
}

enum CommunityRole {
  moderator
  member
}

// ApprovedPhone's own lifecycle — purely "has this admin-added phone been
// claimed/registered by the person yet." Account-level standing (active/
// suspended/deleted) lives on User.status instead — see UserStatus. Expiry
// isn't tracked here either: it's inherently per (user, community), see
// Subscription.isActive/validUntil, not a single member-wide flag.
enum MemberStatus {
  pending
  registered
}

// The account's own standing, independent of any particular community
// membership or subscription. Deliberately does NOT include "expired" — a
// user can hold multiple community subscriptions with independent expiry
// (and some communities may be free, i.e. never expire), so "expired" isn't
// a single fact about the account; check Subscription.isActive/validUntil
// per community instead.
enum UserStatus {
  active
  suspended
  deleted
}

// Where a PostVideo comes from: a file uploaded to MinIO, or a link to a video
// hosted on YouTube / Instagram (embedded, never downloaded).
enum VideoKind {
  file
  youtube
  instagram
}

enum PostStatus {
  draft
  published
}

enum StockActionCall {
  buy
  hold
  exit
}

enum StockRiskLevel {
  low
  medium
  high
}

// Which exchange the AngelOne `token` resolves against — required to
// subscribe the correct exchangeType on the live SmartAPI WebSocket feed.
// Nullable only because pre-existing rows need a one-time backfill; every
// newly-imported/seeded stock always sets it.
enum StockExchange {
  nse
  bse
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @map("full_name") @db.VarChar(100)
  phone        String    @unique @db.VarChar(20)
  email        String?   @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(member)
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  status       UserStatus @default(active)
  suspensionReason String? @map("suspension_reason") @db.Text
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  postNotificationsEnabled Boolean @default(true) @map("post_notifications_enabled")
  // Submitted once from the mobile app (POST /auth/mobile/me/kyc), then locked.
  // panEncrypted is AES-256-GCM ciphertext (see lib/pan-crypto.ts), decryptable
  // only with PAN_ENCRYPTION_KEY — never select or return it from a normal query.
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  panEncrypted   String?   @map("pan_encrypted") @db.VarChar(255)
  kycSubmittedAt DateTime? @map("kyc_submitted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  createdCommunities CommunityMember[]
  posts              Post[]            @relation("PostAuthor")
  pinnedPosts        Post[]            @relation("PostPinnedBy")
  comments           Comment[]
  likes              PostLike[]
  reactions          Reaction[]
  communities        Community[]
  subscriptions      Subscription[]
  notifications      Notification[]
  communityAccess    CommunityAdmin[]
  stockRecommendations StockRecommendation[]
  mobileSession      MobileSession?
  planOrders         PlanOrder[]
  tickets            Ticket[]        @relation("TicketOwner")
  assignedTickets    Ticket[]        @relation("TicketAssignee")
  ticketMessages     TicketMessage[]
  ticketEvents       TicketEvent[]
  servicesCreated         Service[]
  serviceRequests         ServiceRequest[]  @relation("ServiceRequester")
  assignedServiceRequests ServiceRequest[]  @relation("ServiceAssignee")
  serviceMessages         ServiceMessage[]
  serviceEvents           ServiceEvent[]

  @@index([phone], name: "idx_users_phone")
  @@index([email], name: "idx_users_email")
  @@index([role], name: "idx_users_role")
  @@map("users")
}

model ApprovedPhone {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String   @unique @db.VarChar(20)
  name         String?  @db.VarChar(100)
  email        String?  @db.VarChar(255)
  status       MemberStatus @default(pending)
  addedBy      String?  @map("added_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([phone], name: "idx_approved_phones_phone")
  @@map("approved_phones")
}

// Deliberately maps to User only — not ApprovedPhone. A self-registered user
// (self-serve mobile signup, nobody added their phone) never gets an
// ApprovedPhone row at all, so requiring one here would mean such a user
// could never hold a subscription, and therefore could never pass either
// login()'s hasActiveSubscription gate (auth.service.ts / mobile-auth.service.ts)
// — permanently locking them out of an account they just successfully created.
// User<->ApprovedPhone stay linked by phone string only, same as everywhere
// else in this schema; no formal relation needed for that.
model Subscription {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  communityId     String    @map("community_id") @db.Uuid
  planId          String?   @map("plan_id") @db.Uuid
  payment         Decimal   @db.Decimal(10, 2)
  paidOn          DateTime? @map("paid_on") @db.Date
  validUntil      DateTime  @map("valid_until") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  // Why this subscription was created/extended — see SubscriptionSource in
  // notifications.dto.ts-style "as const" object. Nullable: existing rows
  // predate this field and aren't backfilled with a guess.
  source          String?   @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  community     Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  plan          Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_subscriptions_user")
  @@index([communityId], name: "idx_subscriptions_community")
  @@index([userId, communityId], name: "idx_subscriptions_user_community")
  @@index([planId], name: "idx_subscriptions_plan")
  @@map("subscriptions")
}

model Plan {
  id             String    @id @default(uuid()) @db.Uuid
  communityId    String    @map("community_id") @db.Uuid
  name           String    @db.VarChar(100)
  durationMonths Int       @map("duration_months") @db.SmallInt
  price          Decimal   @db.Decimal(10, 2)
  // Soft-delete flag — false means "stopped offering this plan", not erased;
  // existing Subscriptions/PlanOrders keep their planId either way. Every
  // listing/purchase read filters on this instead of a deletedAt column.
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  // Admin who last created/edited/deactivated this plan — loose reference,
  // same convention as ApprovedPhone.addedBy (no FK relation).
  updatedBy      String?   @map("updated_by") @db.Uuid

  community     Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  orders        PlanOrder[]

  @@index([communityId], name: "idx_plans_community")
  @@map("plans")
}

// One row per Razorpay order created for a one-time plan purchase (Orders
// API, not Razorpay Subscriptions — Plan carries no Razorpay fields of its
// own, see the schema doc). `status` moves created -> paid|failed and is set
// exactly once, from PaymentsService#verifyPayment inside the same
// transaction that creates/extends the resulting Subscription.
model PlanOrder {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  communityId       String    @map("community_id") @db.Uuid
  planId            String    @map("plan_id") @db.Uuid
  razorpayOrderId   String    @unique @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?   @unique @map("razorpay_payment_id") @db.VarChar(64)
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("INR") @db.VarChar(10)
  status            String    @default("created") @db.VarChar(20) // created | paid | failed
  subscriptionId    String?   @map("subscription_id") @db.Uuid    // set once verify succeeds
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_plan_orders_user")
  @@index([communityId], name: "idx_plan_orders_community")
  @@map("plan_orders")
}

model Community {
  id            String    @id @default(uuid()) @db.Uuid
  createdBy     String    @map("created_by") @db.Uuid
  name          String    @db.VarChar(150)
  slug          String    @unique @db.VarChar(150)
  description   String?
  tags          String[]
  // Freeform category label set by the admin when creating/editing the
  // community, e.g. "Intraday", "Short Term", "Swing", "Long Term" — distinct
  // from `tags` (a multi-value list). Nullable since existing communities
  // predate this field.
  type          String?   @db.VarChar(50)
  subtitle      String?   @db.VarChar(200)
  // Shared "what's included" bullet list across all of this community's
  // plans (not per-plan).
  whatsIncluded String[]  @map("whats_included")
  // Distinct users with an active, non-expired subscription right now.
  // Stored, not computed-on-read — kept in sync by a recompute call at every
  // subscription-lifecycle write site; backfilled once at migration time.
  activeSubCount Int      @default(0) @map("active_sub_count")
  coverImageUrl String?   @map("cover_image_url") @db.VarChar(500)
  badgeUrl      String?   @map("badge_url") @db.VarChar(500)
  paymentLink   String?   @map("payment_link") @db.VarChar(500)
  // At most one Community should ever have this set — the community every
  // brand-new self-registered user is auto-subscribed to at signup (see
  // mobile-auth.service.ts#finalizeRegistration), so their account isn't
  // permanently locked out of login()'s hasActiveSubscription gate before any
  // admin has done anything. Not enforced as a DB-level uniqueness constraint
  // (no real need for one — this is set/unset by hand via the admin UI).
  isFree        Boolean   @default(false) @map("is_free")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  creator       User              @relation(fields: [createdBy], references: [id])
  members       CommunityMember[]
  posts         Post[]
  subscriptions Subscription[]
  notifications Notification[]
  adminAccess   CommunityAdmin[]
  stockRecommendations StockRecommendation[]
  plans         Plan[]
  planOrders    PlanOrder[]
  kit           CommunityKit?
  tickets       Ticket[]

  @@index([slug], name: "idx_communities_slug")
  @@index([createdBy], name: "idx_communities_created_by")
  @@map("communities")
}

// One-to-one extension of Community holding admin-authored freeform JSON
// content: the trading setup info and the welcome kit shown to subscribers.
model CommunityKit {
  id               String   @id @default(uuid()) @db.Uuid
  communityId      String   @unique @map("community_id") @db.Uuid
  tradingSetupInfo Json?    @map("trading_setup_info")
  welcomeKit       Json?    @map("welcome_kit")
  // Welcome kit shown to subscribers of a paid community (admin: /admin/communities/:id/welcome-kit).
  // Each column is one section; list items carry an explicit `priority` (1..n, = display order).
  //   watchBeforeYouStart: { introMarkdown, youtubeUrls[] }
  //   capitalAllocation:   { heroStat, description, strategyTitle, strategies[{ priority, value, label }] }
  //   strategyNotices:     [{ priority, type: 'normal' | 'warning', heading, description }]
  //   whatYouGet:          [{ priority, text }]
  watchBeforeYouStart Json? @map("watch_before_you_start")
  capitalAllocation   Json? @map("capital_allocation")
  strategyNotices     Json? @map("strategy_notices")
  whatYouGet          Json? @map("what_you_get")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_kits")
}

model CommunityAdmin {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  adminId     String   @map("admin_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  admin     User      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([communityId, adminId], name: "uq_community_admin")
  @@index([communityId], name: "idx_community_admins_community")
  @@index([adminId], name: "idx_community_admins_admin")
  @@map("community_admins")
}

model CommunityMember {
  id          String        @id @default(uuid()) @db.Uuid
  communityId String        @map("community_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        CommunityRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId], name: "uq_community_member")
  @@index([communityId], name: "idx_members_community")
  @@index([userId], name: "idx_members_user")
  @@map("community_members")
}

model Post {
  id          String     @id @default(uuid()) @db.Uuid
  communityId String     @map("community_id") @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  title       String     @db.VarChar(300)
  contentMd   String     @map("content_md")
  imageUrls   String[]   @map("image_urls")
  tags        String[]
  status      PostStatus @default(draft)
  pinOrder    Int?       @map("pin_order") @db.SmallInt
  pinnedAt    DateTime?  @map("pinned_at") @db.Timestamptz
  pinnedBy    String?    @map("pinned_by") @db.Uuid
  publishedAt DateTime?  @map("published_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz
  // Denormalized summary keyed by ReactionType.name, e.g. {"like": 12, "love": 3}
  // — never joins reaction_types just to render counts. Recomputed from scratch
  // (groupBy + overwrite, see ReactionsService) inside the same transaction as
  // every Reaction upsert/delete; never incremented in place. Nullable, no DB
  // default — same convention as the only other Json field in this schema,
  // MobileSession.accessibleCommunityIds, cast to a hand-written TS type at
  // the point of use.
  reactionCounts Json?   @map("reaction_counts")
  // Posts created by one publish to several communities/Feed are independent copies; this
  // shared id lets the admin side show their reactions together. Null for a single-target post.
  publishGroupId String? @map("publish_group_id") @db.Uuid

  community             Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author                User                  @relation("PostAuthor", fields: [authorId], references: [id])
  pinnedByUser          User?                 @relation("PostPinnedBy", fields: [pinnedBy], references: [id])
  comments              Comment[]
  likes                 PostLike[]
  reactions             Reaction[]
  commentNotifications  CommentNotification[]
  videos                PostVideo[]

  // (communityId, pinOrder) uniqueness among non-deleted posts is enforced by a
  // partial unique index created directly in migration SQL (Prisma's schema DSL
  // can't express a WHERE clause on @@unique) — see migration
  // 20260715150000_partial_unique_pin_order. Do not add @@unique here.
  @@index([communityId, status, publishedAt(sort: Desc)], name: "idx_posts_community_feed")
  @@index([communityId, pinOrder], name: "idx_posts_pinned")
  @@index([authorId], name: "idx_posts_author")
  @@index([publishGroupId], name: "idx_posts_publish_group")
  @@map("posts")
}

// Ordered list of videos attached to a post (separate from Post.imageUrls).
// `url` is the public MinIO URL for kind=file, or the canonical watch/post URL
// for youtube/instagram. `externalId` is the YouTube video ID / Instagram shortcode.
model PostVideo {
  id           String    @id @default(uuid()) @db.Uuid
  postId       String    @map("post_id") @db.Uuid
  kind         VideoKind
  url          String    @db.VarChar(1000)
  externalId   String?   @map("external_id") @db.VarChar(64)
  title        String?   @db.VarChar(300)
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(1000)
  position     Int       @db.SmallInt
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position], name: "idx_post_videos_post")
  @@map("post_videos")
}

model Stock {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  symbol    String   @unique @db.VarChar(50)
  sector    String?  @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  token     String?  @db.VarChar(50)
  exchange  StockExchange?
  cmp       Decimal? @db.Decimal(10, 2)
  closePrice Decimal? @map("close_price") @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  recommendations StockRecommendation[]

  @@index([symbol], name: "idx_stocks_symbol")
  @@index([isActive], name: "idx_stocks_active")
  @@map("stocks")
}

model StockRecommendation {
  id                  String          @id @default(uuid()) @db.Uuid
  communityId         String          @map("community_id") @db.Uuid
  recommendedBy       String          @map("recommended_by") @db.Uuid
  stockId             String          @map("stock_id") @db.Uuid
  entryPrice          Decimal         @map("entry_price") @db.Decimal(10, 2)
  targetPrice         Decimal         @map("target_price") @db.Decimal(10, 2)
  stopLossPrice       Decimal         @map("stop_loss_price") @db.Decimal(10, 2)
  actionCall          StockActionCall @map("action_call")
  riskLevel           StockRiskLevel  @map("risk_level")
  recommendationNotes String?         @map("recommendation_notes") @db.Text
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  recommender User      @relation(fields: [recommendedBy], references: [id])
  stock       Stock     @relation(fields: [stockId], references: [id])

  @@index([communityId, deletedAt], name: "idx_stock_recommendations_community_feed")
  @@index([recommendedBy], name: "idx_stock_recommendations_recommended_by")
  @@index([stockId], name: "idx_stock_recommendations_stock")
  @@map("stock_recommendations")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String
  depth     Int       @default(0) @db.SmallInt
  path      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  post         Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User                  @relation(fields: [authorId], references: [id])
  parent       Comment?              @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]             @relation("CommentReplies")
  notification CommentNotification?

  @@index([postId, createdAt], name: "idx_comments_post")
  @@index([path], name: "idx_comments_path")
  @@index([parentId], name: "idx_comments_parent")
  @@map("comments")
}

model CommentNotification {
  id        String    @id @default(uuid()) @db.Uuid
  commentId String    @unique @map("comment_id") @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  isReplied Boolean   @default(false) @map("is_replied")
  repliedAt DateTime? @map("replied_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([isReplied, createdAt(sort: Desc)], name: "idx_comment_notifications_pending")
  @@index([postId], name: "idx_comment_notifications_post")
  @@map("comment_notifications")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], name: "uq_post_like")
  @@index([postId], name: "idx_likes_post")
  @@index([userId], name: "idx_likes_user")
  @@map("post_likes")
}

// Fixed, code-referenced lookup table — no admin CRUD. Rows are seeded via
// raw SQL INSERT embedded in migration 20260908130000_add_post_reactions
// (see that migration's SQL) and never change at runtime. Int PK (not UUID)
// because this is a small, stable, human-assigned enum-like set.
model ReactionType {
  id        Int    @id @db.SmallInt
  name      String @unique @db.VarChar(20)
  emoji     String @db.VarChar(8)
  sortOrder Int    @map("sort_order") @db.SmallInt

  reactions Reaction[]

  @@map("reaction_types")
}

// One row per (post, user) — re-reacting with a different type UPSERTS this
// row (uq_reactions_post_user) rather than adding a new one, unlike the
// simpler append-only PostLike above. updatedAt is present because
// reactionTypeId can change after creation.
model Reaction {
  id             String   @id @default(uuid()) @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  reactionTypeId Int      @map("reaction_type_id") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType ReactionType @relation(fields: [reactionTypeId], references: [id])

  @@unique([postId, userId], name: "uq_reactions_post_user")
  @@index([postId], name: "idx_reactions_post")
  @@index([userId], name: "idx_reactions_user")
  @@map("reactions")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String   @db.VarChar(50)
  sourceId    String   @map("source_id") @db.Uuid
  title       String   @db.Text
  message     String   @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId], name: "uq_notifications_user_type_source")
  @@index([userId, createdAt(sort: Desc)], name: "idx_notifications_user_feed")
  @@index([userId, isRead], name: "idx_notifications_user_unread")
  @@index([communityId], name: "idx_notifications_community")
  @@map("notifications")
}

enum MobileDeviceType {
  ios
  android
}

// One row per user (userId is unique, not a soft "isActive" flag) — a fresh
// mobile login upserts this row, which IS the entire "kill any prior mobile
// session, install this one" mechanism: sessionIdHash is unique, so once a
// login overwrites it, any request carrying the old raw session id can no
// longer find a matching row at all. Logout deletes the row outright rather
// than flagging it inactive, matching "session removed on logout" literally.
//
// communityIds/selectedCommunityId/accessibleCommunityIds are a deliberate
// cache (Option C): role/isActive/isSuperAdmin are read live via the join to
// User on every request (so a suspension takes effect immediately), but these
// three are comparatively expensive to (re)compute (subscriptions + admin
// community-grants), so they're only refreshed at login and on
// POST /auth/mobile/select-community — a brief staleness window that's
// accepted as low-stakes relative to querying them on every single request.
model MobileSession {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @unique @map("user_id") @db.Uuid
  sessionIdHash String            @unique @map("session_id_hash") @db.VarChar(64)
  deviceId      String?           @map("device_id") @db.VarChar(255)
  deviceType    MobileDeviceType? @map("device_type")
  deviceName    String?           @map("device_name") @db.VarChar(255)
  ip            String?           @db.VarChar(45)

  communityIds        String[] @map("community_ids")
  selectedCommunityId String?  @map("selected_community_id") @db.Uuid
  // Json, not String[] — Prisma has no nullable-scalar-list type, and null vs.
  // an array (however short) is a meaningful distinction here: null means
  // "super admin, unrestricted," a real array (empty included) means
  // "restricted to exactly these community ids." Stored/read as
  // `string[] | null` in application code (see src/lib/mobile-session.ts).
  accessibleCommunityIds Json? @map("accessible_community_ids")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mobile_sessions")
}

// ─── Support tickets ────────────────────────────────────────────────────────
// A user (mobile app only) raises a ticket against one of their communities;
// admins with access to that community (or a super admin) answer it in a
// per-ticket chat. Lifecycle is open -> in_progress -> resolved; resolved is
// terminal and read-only (no reopen, no further messages — only the rating
// can still be written).

enum TicketCategory {
  payments
  subscription
  account
  content
  app_bug
  other
}

enum TicketType {
  issue
  question
  feature_request
  refund_request
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum TicketSenderRole {
  user
  admin
}

enum TicketEventType {
  created
  assigned
  reassigned
  resolved
}

model Ticket {
  id              String         @id @default(uuid()) @db.Uuid
  // Human-readable id shown as FS-<number>; gaps are fine.
  number          Int            @unique @default(autoincrement())
  userId          String         @map("user_id") @db.Uuid
  communityId     String         @map("community_id") @db.Uuid
  category        TicketCategory
  type            TicketType
  subject         String         @db.VarChar(150)
  description     String         @db.VarChar(2000)
  status          TicketStatus   @default(open)
  // The one admin responsible for this ticket. Set on claim / first admin
  // reply; only they (or a super admin) can reply or resolve afterwards.
  assignedAdminId String?        @map("assigned_admin_id") @db.Uuid
  // Client-generated key (Idempotency-Key header) so a double-tap / retry on
  // POST /tickets returns the original ticket instead of creating a second.
  clientRequestId String         @map("client_request_id") @db.VarChar(64)

  // Denormalised per-side unread counters: bumped when the *other* side
  // sends a message, zeroed by the mark-read endpoint.
  userUnreadCount  Int      @default(0) @map("user_unread_count")
  adminUnreadCount Int      @default(0) @map("admin_unread_count")
  // Millisecond precision on purpose: the keyset cursors (tickets.shared.ts) round-trip this
  // through a JS Date, so sub-millisecond digits would make rows sharing a millisecond skippable.
  lastMessageAt    DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)

  // Written once by the owner after resolve; immutable.
  rating        Int?      @db.SmallInt
  ratingComment String?   @map("rating_comment") @db.VarChar(1000)
  ratedAt       DateTime? @map("rated_at") @db.Timestamptz

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User               @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?              @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  community     Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
  attachments   TicketAttachment[]
  events        TicketEvent[]

  @@unique([userId, clientRequestId], name: "uq_tickets_user_request")
  @@index([communityId, status], name: "idx_tickets_community_status")
  @@index([assignedAdminId, status], name: "idx_tickets_assignee_status")
  @@index([userId, lastMessageAt(sort: Desc)], name: "idx_tickets_user_recent")
  @@map("tickets")
}

model TicketMessage {
  id              String           @id @default(uuid()) @db.Uuid
  ticketId        String           @map("ticket_id") @db.Uuid
  senderId        String           @map("sender_id") @db.Uuid
  senderRole      TicketSenderRole @map("sender_role")
  // Optional because a message may be attachments-only (service enforces
  // that at least one of body / attachments is present).
  body            String?          @db.VarChar(2000)
  // Client-generated so a retried send doesn't post the message twice.
  clientMessageId String           @map("client_message_id") @db.VarChar(64)
  // Millisecond precision — see Ticket.lastMessageAt.
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]

  @@unique([ticketId, clientMessageId], name: "uq_ticket_messages_client_id")
  @@index([ticketId, createdAt(sort: Desc)], name: "idx_ticket_messages_thread")
  @@map("ticket_messages")
}

model TicketAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  // null = attached to the ticket's original description rather than a chat message.
  messageId String?  @map("message_id") @db.Uuid
  // Object key inside the private tickets bucket — never a public URL;
  // download links are presigned per request.
  objectKey String   @map("object_key") @db.VarChar(300)
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket  Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId], name: "idx_ticket_attachments_ticket")
  @@index([messageId], name: "idx_ticket_attachments_message")
  @@map("ticket_attachments")
}

// Audit trail powering the admin timeline.
model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  type      TicketEventType
  actorId   String          @map("actor_id") @db.Uuid
  // For assigned / reassigned: { toAdminId, fromAdminId? }.
  meta      Json?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], name: "idx_ticket_events_ticket")
  @@map("ticket_events")
}

// ─── Services ───────────────────────────────────────────────────────────────
// A global catalog of services (not tied to a community) that members request
// from the support team. A request is worked like a ticket: one admin owns it,
// they chat, the admin sends a quote, the member pays, the admin delivers the
// service outside the platform and closes the request. Phase 1 covers the
// catalog, requests and chat; quotes, payments and invoices come next.

enum ServiceRequestStatus {
  requested
  quote_sent
  paid
  closed
}

enum ServiceClosedReason {
  completed
  declined
  cancelled_by_member
}

enum ServiceSenderRole {
  user
  admin
  system
}

enum ServiceMessageKind {
  text
  quote
  system
}

enum ServiceEventType {
  created
  assigned
  reassigned
  quote_sent
  quote_superseded
  quote_expired
  paid
  closed
  cancelled
  payment_flagged
}

model Service {
  id          String    @id @default(uuid()) @db.Uuid
  // Internal label for admins; `title` is what members see.
  name        String    @db.VarChar(150)
  title       String    @db.VarChar(200)
  description String    @db.VarChar(5000)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  creator  User             @relation(fields: [createdBy], references: [id])
  requests ServiceRequest[]

  @@index([isActive, deletedAt], name: "idx_services_active")
  @@map("services")
}

model ServiceRequest {
  id              String               @id @default(uuid()) @db.Uuid
  // Human-readable id shown as SR-<number>; gaps are fine.
  number          Int                  @unique @default(autoincrement())
  userId          String               @map("user_id") @db.Uuid
  serviceId       String               @map("service_id") @db.Uuid
  status          ServiceRequestStatus @default(requested)
  // Set when status becomes closed.
  closedReason    ServiceClosedReason? @map("closed_reason")
  // What the member needs, in their own words (the first "message" of the conversation).
  needs           String               @db.VarChar(2000)
  // The one admin responsible for this request. Set on claim / first admin reply;
  // only they (or a super admin) can reply or close afterwards.
  assignedAdminId String?              @map("assigned_admin_id") @db.Uuid
  // Client-generated key (Idempotency-Key header) so a retry returns the original request.
  clientRequestId String               @map("client_request_id") @db.VarChar(64)

  userUnreadCount  Int      @default(0) @map("user_unread_count")
  adminUnreadCount Int      @default(0) @map("admin_unread_count")
  // Millisecond precision on purpose: keyset cursors round-trip this through a JS Date.
  lastMessageAt    DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)

  paidAt        DateTime? @map("paid_at") @db.Timestamptz
  closedAt      DateTime? @map("closed_at") @db.Timestamptz
  // Written once by the member after a completed request; immutable.
  rating        Int?      @db.SmallInt
  ratingComment String?   @map("rating_comment") @db.VarChar(1000)
  ratedAt       DateTime? @map("rated_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User                @relation("ServiceRequester", fields: [userId], references: [id], onDelete: Cascade)
  service       Service             @relation(fields: [serviceId], references: [id])
  assignedAdmin User?               @relation("ServiceAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      ServiceMessage[]
  attachments   ServiceAttachment[]
  events        ServiceEvent[]

  @@unique([userId, clientRequestId], name: "uq_service_requests_user_request")
  @@index([status], name: "idx_service_requests_status")
  @@index([assignedAdminId, status], name: "idx_service_requests_assignee_status")
  @@index([userId, lastMessageAt(sort: Desc)], name: "idx_service_requests_user_recent")
  @@index([serviceId], name: "idx_service_requests_service")
  @@map("service_requests")
}

model ServiceMessage {
  id              String             @id @default(uuid()) @db.Uuid
  requestId       String             @map("request_id") @db.Uuid
  // Empty for system messages (e.g. "Payment received").
  senderId        String?            @map("sender_id") @db.Uuid
  senderRole      ServiceSenderRole  @map("sender_role")
  kind            ServiceMessageKind @default(text)
  // Optional because a message may be attachments-only.
  body            String?            @db.VarChar(2000)
  // Client-generated so a retried send doesn't post twice. Empty for system messages.
  clientMessageId String?            @map("client_message_id") @db.VarChar(64)
  // Millisecond precision — see ServiceRequest.lastMessageAt.
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  request     ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender      User?               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments ServiceAttachment[]

  @@unique([requestId, clientMessageId], name: "uq_service_messages_client_id")
  @@index([requestId, createdAt(sort: Desc)], name: "idx_service_messages_thread")
  @@map("service_messages")
}

model ServiceAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  // null = attached to the request's original description rather than a chat message.
  messageId String?  @map("message_id") @db.Uuid
  // Object key inside the private bucket (services/<userId>/…) — never a public URL.
  objectKey String   @map("object_key") @db.VarChar(300)
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  request ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message ServiceMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([requestId], name: "idx_service_attachments_request")
  @@index([messageId], name: "idx_service_attachments_message")
  @@index([objectKey], name: "idx_service_attachments_object")
  @@map("service_attachments")
}

model ServiceEvent {
  id        String           @id @default(uuid()) @db.Uuid
  requestId String           @map("request_id") @db.Uuid
  type      ServiceEventType
  actorId   String?          @map("actor_id") @db.Uuid
  meta      Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt], name: "idx_service_events_request")
  @@map("service_events")
}
