# App
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://community.finskool21.in
CORS_CREDENTIALS=true
COOKIE_SECURE=true

# Used to build absolute links back to the app (e.g. the CTA button in notification emails)
FRONTEND_URL=https://community.finskool21.in

# Email template logo — swap this to change the logo across every email template
EMAIL_LOGO_URL=https://community.finskool21.in/logo.svg

# Database
DATABASE_URL=postgresql://finskool:YOUR_DB_PASSWORD@postgres:5432/finskool
POSTGRES_DB=finskool
POSTGRES_USER=finskool
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_PORT=5433

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0

# JWT
JWT_SECRET=YOUR_64_CHAR_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO
MINIO_ENDPOINT=minio
# Public/browser-facing URLs go through nginx's /assets/ prefix on the same domain — see
# docker/nginx.conf — not a direct connection to MinIO, so no separate port is exposed.
MINIO_PUBLIC_ENDPOINT=community.finskool21.in
MINIO_PORT=9000
MINIO_PUBLIC_PORT=443
MINIO_CONSOLE_PORT=9003
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=true
MINIO_ACCESS_KEY=YOUR_MINIO_USER
MINIO_SECRET_KEY=YOUR_MINIO_PASSWORD
MINIO_BUCKET=finskool

# SMTP — set to a real relay (Gmail SMTP, SendGrid, SES, etc.) for production
# delivery, or to the mailhog service below to only catch mail locally.
SMTP_HOST=smtp.gmail.com
SMTP_SECURE=false
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_SMTP_FROM

# AngelOne SmartAPI — used for the live stock-price WebSocket feed
ANGELONE_API_KEY=YOUR_ANGELONE_API_KEY
ANGELONE_CLIENT_CODE=YOUR_ANGELONE_CLIENT_CODE
ANGELONE_PIN=YOUR_ANGELONE_PIN
ANGELONE_TOTP_SECRET=YOUR_ANGELONE_TOTP_SECRET

# Finedge quote API — used for the daily 3:30 PM stock close-price sweep
STOCK_QUOTE_API_BASE_URL=YOUR_STOCK_QUOTE_API_BASE_URL
STOCK_QUOTE_API_KEY=YOUR_STOCK_QUOTE_API_KEY
# Comma-separated — who gets the daily sweep summary email. Leave blank to disable.
STOCK_REPORT_EMAIL=

